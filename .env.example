# API Keys (Provide at least one LLM provider key or use mock provider)
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# LLM Configuration
DEFAULT_LLM_PROVIDER=mock  # Options: openai, google, mock
DEFAULT_MODEL_NAME=gpt-4o-mini  # e.g., gpt-4o-mini, gemini-2.0-flash, or mock

# Application Configuration
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./collaboration_system.db
MAX_REVIEW_ITERATIONS=2
DEBUG=True
